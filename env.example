# Copy this file to .env and fill in your actual key.
# .env is already gitignored — never commit your real key.

ADMIN_API_KEY=your_admin_dashboard_key_here

# Optional. Where cases.db lives -- unset locally (defaults to
# ./cases.db). On Railway, point this at a mounted Volume's path
# (e.g. /data/cases.db) so cases survive redeploys -- Railway's
# default container filesystem is wiped on every fresh deploy, taking
# cases.db with it. Without a volume, seed_data.py's startup seeding
# (see app.py) re-populates demo cases on every deploy, but any real
# reports collected between deploys are lost.
CASES_DB_PATH=cases.db

# Primary provider as of 2026-08-29 for BOTH response generation
# (response_engine.py) and voice transcription (voice_service.py,
# Groq's hosted Whisper). From console.groq.com -> API keys -- free
# tier is generous enough that this is the one key most things here
# actually depend on working.
GROQ_API_KEY=your_groq_api_key_here

# Generation fallback tier if Groq's call fails -- response_engine.py
# tries Groq first, then this, then OPENROUTER_API_KEY below.
GEMINI_API_KEY=your_gemini_api_key_here

# Generation fallback tier, tried last (free-model rate limits, so
# treated as a last resort rather than a primary).
# From openrouter.ai -> Keys.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Voice transcription fallback if Groq's call fails. From
# platform.openai.com -> API keys. Needs an account with active
# billing/credits, not just a key -- a key on a zero-credit account
# fails every transcription call. Optional: if unset (or Groq is also
# unavailable), voice_service.py falls back to a placeholder
# transcript rather than failing the report.
OPENAI_API_KEY=your_openai_api_key_here

# On hold as of 2026-08-24 -- government approval never cleared before
# the deadline, so voice_service.py was switched to OPENAI_API_KEY
# above. Kept here in case Bhashini access comes through later; unused
# while it's unset.
# From bhashini.gov.in/ulca -> My Profile -> Generate API Key
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here

# ------------------------------------------------------------
# WHATSAPP (Twilio) -- optional, for the live WhatsApp channel
# ------------------------------------------------------------
# Only needed to run /whatsapp/webhook. Everything else works without
# these. From console.twilio.com -> Account Info.
#
# TWILIO_AUTH_TOKEN is what verifies a webhook request actually came
# from Twilio. Without it the endpoint accepts unsigned requests --
# fine locally, NOT fine on a public deployment, since anyone who
# finds the URL could then create real cases in the counsellor queue.
#
# Setup: Twilio Console -> Messaging -> Try it out -> Send a WhatsApp
# message. Join the sandbox from your phone, then set the sandbox's
# "When a message comes in" webhook to:
#     https://<your-deployment>/whatsapp/webhook   (HTTP POST)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Acoustic voice-feature extraction (librosa) for the SVI's voice half.
# Off by default: it pulls in numba/llvmlite and holds the decoded
# waveform in memory on top of the embedding model and ChromaDB, which
# is enough to get a memory-capped container killed mid-request -- with
# no exception and no log line, so the reply just never arrives.
# Set to 1 where the RAM exists (local dev, a paid instance) to get
# full text+voice SVI fusion. Where it's off, voice notes still
# transcribe, assess, escalate and reply -- on the transcript alone.
ENABLE_VOICE_FEATURES=1
