# Copy this file to .env and fill in your actual key.
# .env is already gitignored — never commit your real key.

ADMIN_API_KEY=your_admin_dashboard_key_here

# Primary provider as of 2026-08-29 for BOTH response generation
# (response_engine.py) and voice transcription (voice_service.py,
# Groq's hosted Whisper). From console.groq.com -> API keys -- free
# tier is generous enough that this is the one key most things here
# actually depend on working.
GROQ_API_KEY=your_groq_api_key_here

# Generation fallback tier if Groq's call fails -- response_engine.py
# tries Groq first, then this, then OPENROUTER_API_KEY below.
GEMINI_API_KEY=your_gemini_api_key_here

# Generation fallback tier, tried last (free-model rate limits, so
# treated as a last resort rather than a primary).
# From openrouter.ai -> Keys.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Voice transcription fallback if Groq's call fails. From
# platform.openai.com -> API keys. Needs an account with active
# billing/credits, not just a key -- a key on a zero-credit account
# fails every transcription call. Optional: if unset (or Groq is also
# unavailable), voice_service.py falls back to a placeholder
# transcript rather than failing the report.
OPENAI_API_KEY=your_openai_api_key_here

# On hold as of 2026-08-24 -- government approval never cleared before
# the deadline, so voice_service.py was switched to OPENAI_API_KEY
# above. Kept here in case Bhashini access comes through later; unused
# while it's unset.
# From bhashini.gov.in/ulca -> My Profile -> Generate API Key
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
